[
  {
    "rule_id": "PC_RULE_001_MFG_DETAILS",
    "rule_name": "Manufacturer/Packer/Importer Details",
    "description": "Verifies the presence of the name and address of the manufacturer, packer, or importer.",
    "traceability": {
      "source_document": "Legal Metrology (Packaged Commodities) Rules, 2011",
      "source_rule": "Rule 6",
      "source_clause": "Sub-rule (1)(a)",
      "source_amendment_year": "2011 (Base)"
    },
    "effective_date": "2011-03-07",
    "requirement": "Every package shall bear the name and address of the manufacturer, or where the manufacturer is not the packer, the name and address of the manufacturer and packer and for any imported package the name and address of the importer.",
    "input_field": "manufacturer_packer_importer_details",
    "condition": "EXISTS",
    "applicability_conditions": [
      {
        "field": "package_context",
        "operator": "EQUALS",
        "value": "retail"
      }
    ],
    "exemption_conditions": [
      {
        "field": "product_category",
        "operator": "EQUALS",
        "value": "medical_device"
      }
    ],
    "severity": "critical",
    "failure_message": "The name and address of the manufacturer, packer, or importer is missing.",
    "evidence_requirement": "Extracted text showing the name and address.",
    "version": "1.0",
    "status": "human_verified",
    "human_verification_required": false
  },
